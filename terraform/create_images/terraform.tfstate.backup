            "tenancy": "default",
            "timeouts": null,
            "user_data": "#!/bin/bash\r\n#install MySQL server\r\nsudo apt-get update\r\nsudo apt-get install -y mysql-server\r\n\r\n# Configure MySQL to allow remote connections\r\nsudo sed -i 's/^bind-address\\s*=.*$/bind-address = 0.0.0.0/' /etc/mysql/mysql.conf.d/mysqld.cnf\r\n\r\n# Restart MySQL service\r\nsudo systemctl restart mysql\r\n\r\n# create non-root user and CivilRegistry db that this user has full access to\r\nsudo mysql -u root -e \"CREATE USER 'appuser'@'%' IDENTIFIED BY 'dokimi';\"\r\nsudo mysql -u root -e \"CREATE DATABASE civilregistry;\"\r\nsudo mysql -u root -e \"GRANT ALL PRIVILEGES ON civilregistry.* TO 'appuser'@'%' WITH GRANT OPTION;\"\r\nsudo mysql -u root -e \"FLUSH PRIVILEGES;\"\r\ntouch /tmp/user_data_complete\r\n",
            "user_data_base64": null,
            "user_data_replace_on_change": false,
            "volume_tags": null,
